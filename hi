
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-VQ75Z3PXN2"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-VQ75Z3PXN2');
</script>
  <title>Pantaloons Fashion Store</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: #faf9f6;
      color: #252525;
    }

    header {
      background: #e52335;
      color: white;
      padding: 20px 6%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    .logo {
      font-size: 29px;
      font-weight: bold;
      letter-spacing: 1px;
    }

    .cart-button {
      background: white;
      color: #e52335;
      border: none;
      border-radius: 25px;
      padding: 12px 20px;
      font-weight: bold;
      cursor: pointer;
    }

    .hero {
      min-height: 330px;
      padding: 55px 8%;
      display: flex;
      align-items: center;
      background:
        linear-gradient(90deg, rgba(0,0,0,.70), rgba(0,0,0,.05)),
        url("https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=1600&q=85")
        center/cover;
      color: white;
    }

    .hero-content {
      max-width: 470px;
    }

    .hero h1 {
      font-size: clamp(34px, 5vw, 52px);
      margin-bottom: 15px;
    }

    .hero p {
      font-size: 17px;
      line-height: 1.6;
      margin-bottom: 22px;
    }

    .shop-button {
      display: inline-block;
      background: #e52335;
      color: white;
      text-decoration: none;
      padding: 13px 24px;
      border-radius: 5px;
      font-weight: bold;
    }

    .section {
      padding: 42px 6%;
    }

    .section h2 {
      text-align: center;
      font-size: 30px;
      margin-bottom: 12px;
    }

    .subtitle {
      text-align: center;
      color: #666;
      margin-bottom: 25px;
    }

    .filters {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 30px;
    }

    .filter {
      border: 1px solid #ddd;
      background: white;
      padding: 10px 17px;
      border-radius: 22px;
      cursor: pointer;
    }

    .filter.active,
    .filter:hover {
      background: #e52335;
      color: white;
      border-color: #e52335;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 22px;
    }

    .product {
      background: white;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 3px 15px #0000000c;
      transition: transform .2s;
    }

    .product:hover {
      transform: translateY(-4px);
    }

    .product img {
      display: block;
      width: 100%;
      height: 250px;
      object-fit: cover;
      background: #eee;
    }

    .product-info {
      padding: 16px;
    }

    .product-info h3 {
      font-size: 17px;
      margin-bottom: 9px;
    }

    .price {
      font-size: 20px;
      font-weight: bold;
      color: #e52335;
    }

    .old-price {
      font-size: 14px;
      color: #888;
      text-decoration: line-through;
      margin-left: 6px;
    }

    .tag {
      display: inline-block;
      background: #fff0f0;
      color: #d52232;
      padding: 5px 8px;
      border-radius: 4px;
      font-size: 12px;
      margin: 10px 0;
    }

    .add-button {
      width: 100%;
      padding: 12px;
      background: #252525;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
      margin-top: 8px;
    }

    .add-button:hover {
      background: #e52335;
    }

    .cart-panel {
      background: white;
      border: 1px solid #eee;
      border-radius: 10px;
      padding: 22px;
      margin-top: 25px;
      display: none;
    }

    .cart-panel h3 {
      margin-bottom: 15px;
    }

    .cart-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      border-bottom: 1px solid #eee;
      padding: 12px 0;
    }

    .quantity button {
      width: 28px;
      height: 28px;
      cursor: pointer;
      border: 1px solid #ddd;
      background: white;
      border-radius: 4px;
    }

    .cart-total {
      font-size: 22px;
      font-weight: bold;
      margin: 20px 0;
    }

    .checkout {
      background: #16834a;
      color: white;
      border: none;
      padding: 13px 22px;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
    }

    .benefits {
      background: #fff0f0;
      display: flex;
      justify-content: space-around;
      flex-wrap: wrap;
      gap: 20px;
      padding: 28px 6%;
      text-align: center;
    }

    .benefits strong {
      display: block;
      margin-bottom: 7px;
    }

    footer {
      background: #222;
      color: white;
      text-align: center;
      padding: 25px 15px;
      line-height: 1.8;
    }

    @media (max-width: 900px) {
      .products {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 480px) {
      header {
        padding: 17px 5%;
      }

      .logo {
        font-size: 23px;
      }

      .hero {
        min-height: 300px;
        padding: 35px 6%;
      }

      .section {
        padding: 32px 4%;
      }

      .products {
        gap: 12px;
      }

      .product img {
        height: 185px;
      }

      .product-info {
        padding: 11px;
      }

      .product-info h3 {
        font-size: 15px;
      }

      .cart-item {
        flex-wrap: wrap;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="logo">PANTALOONS</div>
    <button class="cart-button"
      onclick="toggleCart()">
      🛍 My Cart (<span id="cart-count">0</span>)
    </button>
  </header>

  <section class="hero">
    <div class="hero-content">
      <h1>Fashion for Every You.</h1>
      <p>
        Discover trendy styles, everyday essentials,
        and fresh looks at pocket-friendly prices.
      </p>
      <a class="shop-button" href="#shop">
        EXPLORE COLLECTION
      </a>
    </div>
  </section>

  <section class="section" id="shop">
    <h2>Trending Collection</h2>
    <p class="subtitle">
      Find your style without spending too much.
    </p>

    <div class="filters">
      <button class="filter active"
        onclick="filterProducts('All', this)">All</button>
      <button class="filter"
        onclick="filterProducts('Men', this)">Men</button>
      <button class="filter"
        onclick="filterProducts('Women', this)">Women</button>
      <button class="filter"
        onclick="filterProducts('Kids', this)">Kids</button>
    </div>

    <div class="products" id="products"></div>

    <div class="cart-panel" id="cart-panel">
      <h3>🛒 Your Shopping Cart</h3>
      <div id="cart-items"></div>
      <div class="cart-total">
        Total: ₹<span id="cart-total">0</span>
      </div>
      <button class="checkout" onclick="checkout()">
        Proceed to Checkout
      </button>
    </div>
  </section>

  <section class="benefits">
    <div>
      <strong>🚚 Free Delivery</strong>
      <span>On orders above ₹999</span>
    </div>
    <div>
      <strong>✨ Latest Styles</strong>
      <span>Fashion for everyone</span>
    </div>
    <div>
      <strong>💳 Easy Shopping</strong>
      <span>Simple cart experience</span>
    </div>
  </section>

  <footer>
    <h3>PANTALOONS FASHION</h3>
    <p>Style that fits your life and your budget.</p>
    <p>© 2026 Fashion Store Demo</p>
    <small>
      Student/demo project. Not an official Pantaloons website.
    </small>
  </footer>

  <script>
    const products = [
      {
        id: 1,
        name: "Classic Casual Shirt",
        category: "Men",
        price: 699,
        old: 999,
        tag: "30% OFF",
        image: "https://images.unsplash.com/photo-1603252109303-2751441dd157?auto=format&fit=crop&w=700&q=80"
      },
      {
        id: 2,
        name: "Women's Summer Dress",
        category: "Women",
        price: 999,
        old: 1499,
        tag: "BESTSELLER",
        image: "https://images.unsplash.com/photo-1539008835657-9e8e9680c956?auto=format&fit=crop&w=700&q=80"
      },
      {
        id: 3,
        name: "Everyday Denim Jeans",
        category: "Men",
        price: 899,
        old: 1299,
        tag: "TRENDING",
        image: "https://images.unsplash.com/photo-1542272604-787c3835535d?auto=format&fit=crop&w=700&q=80"
      },
      {
        id: 4,
        name: "Women's Casual Top",
        category: "Women",
        price: 499,
        old: 799,
        tag: "VALUE BUY",
        image: "https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?auto=format&fit=crop&w=700&q=80"
      },
      {
        id: 5,
        name: "Urban Everyday T-Shirt",
        category: "Men",
        price: 549,
        old: 799,
        tag: "POPULAR",
        image: "https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=700&q=80"
      },
      {
        id: 6,
        name: "Elegant Women's Outfit",
        category: "Women",
        price: 1199,
        old: 1599,
        tag: "NEW ARRIVAL",
        image: "https://images.unsplash.com/photo-1485230895905-ec40ba36b9bc?auto=format&fit=crop&w=700&q=80"
      },
      {
        id: 7,
        name: "Kids Casual Outfit",
        category: "Kids",
        price: 599,
        old: 899,
        tag: "VALUE BUY",
        image: "https://images.unsplash.com/photo-1519238263530-99bdd11df2ea?auto=format&fit=crop&w=700&q=80"
      },
      {
        id: 8,
        name: "Comfortable Casual Pants",
        category: "Men",
        price: 799,
        old: 1099,
        tag: "30% OFF",
        image: "https://images.unsplash.com/photo-1473966968600-fa801b869a1a?auto=format&fit=crop&w=700&q=80"
      }
    ];

    let cart = [];
    let currentCategory = "All";

    function renderProducts() {
      const container = document.getElementById("products");
      const filtered = products.filter(product =>
        currentCategory === "All" ||
        product.category === currentCategory
      );

      container.innerHTML = filtered.map(product => `
        <article class="product">
          <img
            src="${product.image}"
            alt="${product.name}"
            loading="lazy"
            onerror="this.onerror=null;this.src='https://placehold.co/500x600/f5f0eb/333333?text=Fashion+Product'"
          >
          <div class="product-info">
            <h3>${product.name}</h3>
            <span class="price">₹${product.price}</span>
            <span class="old-price">₹${product.old}</span>
            <br>
            <span class="tag">${product.tag}</span>
            <button class="add-button"
              onclick="addToCart(${product.id})">
              Add to Cart +
            </button>
          </div>
        </article>
      `).join("");
    }

    function filterProducts(category, button) {
      currentCategory = category;

      document.querySelectorAll(".filter").forEach(item => {
        item.classList.remove("active");
      });

      button.classList.add("active");
      renderProducts();
    }

    function addToCart(id) {
      const product = products.find(item => item.id === id);
      const existing = cart.find(item => item.id === id);

      if (existing) {
        existing.quantity++;
      } else {
        cart.push({ ...product, quantity: 1 });
      }

      renderCart();

      document.getElementById("cart-panel").style.display = "block";
      document.getElementById("cart-panel").scrollIntoView({
        behavior: "smooth",
        block: "nearest"
      });
    }

    function changeQuantity(id, amount) {
      const item = cart.find(item => item.id === id);
      if (!item) return;

      item.quantity += amount;

      if (item.quantity <= 0) {
        cart = cart.filter(item => item.id !== id);
      }

      renderCart();
    }

    function renderCart() {
      const count = cart.reduce(
        (sum, item) => sum + item.quantity, 0
      );

      const total = cart.reduce(
        (sum, item) => sum + item.price * item.quantity, 0
      );

      document.getElementById("cart-count").textContent = count;
      document.getElementById("cart-total").textContent =
        total.toLocaleString("en-IN");

      document.getElementById("cart-items").innerHTML =
        cart.length
          ? cart.map(item => `
              <div class="cart-item">
                <div>
                  <strong>${item.name}</strong><br>
                  ₹${item.price.toLocaleString("en-IN")} each
                </div>
                <div class="quantity">
                  <button onclick="changeQuantity(${item.id}, -1)"
                    aria-label="Decrease quantity">−</button>
                  <span> ${item.quantity} </span>
                  <button onclick="changeQuantity(${item.id}, 1)"
                    aria-label="Increase quantity">+</button>
                </div>
                <strong>
                  ₹${(item.price * item.quantity).toLocaleString("en-IN")}
                </strong>
              </div>
            `).join("")
          : "<p>Your cart is empty. Add some stylish clothes!</p>";
    }

    function toggleCart() {
      const panel = document.getElementById("cart-panel");
      panel.style.display =
        panel.style.display === "block" ? "none" : "block";

      if (panel.style.display === "block") {
        panel.scrollIntoView({
          behavior: "smooth",
          block: "nearest"
        });
      }
    }

    function checkout() {
      if (cart.length === 0) {
        alert("Your cart is empty. Please add a product first.");
        return;
      }

      const total = cart.reduce(
        (sum, item) => sum + item.price * item.quantity, 0
      );

      alert(
        "Demo checkout only!\n" +
        "Items: " + cart.reduce((s, i) => s + i.quantity, 0) +
        "\nTotal: ₹" + total.toLocaleString("en-IN") +
        "\nNo actual order or payment has been placed."
      );
    }

    renderProducts();
    renderCart();
  </script>

</body>
</html>
